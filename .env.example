# =====================================================================
# Copie este arquivo para ".env" e ajuste o que quiser.
# Todos os valores têm default no docker-compose.yml, então o projeto
# roda mesmo sem o .env — mas em produção NUNCA use estas senhas.
# =====================================================================

# --- Credenciais da interface web do Airflow ---
# login: admin / senha: admin  (criado pelo serviço airflow-init)

# --- Data lake (API S3 — RustFS local, AWS S3/GCS/R2 em produção) ---
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin12345
S3_BUCKET=bronze
# Só mude se apontar para um storage fora do compose:
# S3_ENDPOINT=rustfs:9000
# S3_SECURE=false

# --- Postgres do Data Warehouse ---
DW_USER=dw
DW_PASSWORD=dw12345
DW_DB=warehouse

# --- API CoinGecko ---
# A API pública funciona sem chave, com limite de requisições.
# Se quiser mais limite, crie uma demo key em https://www.coingecko.com/en/api
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3/coins/markets

# --- Quantidade de moedas por execução ---
COINGECKO_PER_PAGE=100
